# Copy to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here

# Pick one (same API key from https://aistudio.google.com):
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemma-4-31b-it

# Gemini 2.5 only — leave 0 for Gemma models
GEMINI_THINKING_BUDGET=0

# Show Arcade maze window after successful sandbox validation
NEXAI_SHOW_GUI_PREVIEW=false

# Optional LAN status endpoints
NEXAI_STATUS_HOST=127.0.0.1
NEXAI_STATUS_PORT=5050
NEXAI_PROFILER_PORT=5000
